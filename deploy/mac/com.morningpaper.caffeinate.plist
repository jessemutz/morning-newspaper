<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps the Mac awake 05:06-06:06 so the TrueNAS run can reach llama-server.
     Pair with: sudo pmset repeat wakeorpoweron MTWRFSU 05:05:00
     Install:   cp deploy/mac/*.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.morningpaper.*.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.morningpaper.caffeinate</string>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/caffeinate</string><string>-i</string><string>-s</string><string>-t</string><string>3600</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>6</integer></dict>
</dict>
</plist>
